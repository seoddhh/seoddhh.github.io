---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="대화를 찾을 수 없습니다">
  <main class="flex flex-1 flex-col items-center justify-center gap-3 px-4 pb-[14vh] text-center">
    <p class="text-sm text-fg-subtle">404</p>
    <h1 class="text-2xl font-medium tracking-tight">대화를 찾을 수 없습니다</h1>
    <a href="/" class="mt-3 rounded-full bg-inverse px-4 py-2 text-sm font-medium text-inverse-fg" data-pressable>새 채팅 시작하기</a>
  </main>
</AppLayout>
