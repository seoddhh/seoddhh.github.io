---
import AppLayout from '../layouts/AppLayout.astro';
import ChatInput from '../components/ChatInput.astro';
import HeroIntro from '../components/HeroIntro.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import site from '../content/site.json';
import { chatHref, firstQuestion, getChats, getProfile, getProjectChats, getProjects, projectOf } from '../lib/content';

const CARD_LIMIT = 8;

// 태그로 카드 아이콘을 고릅니다. 없으면 기본 아이콘을 씁니다.
const ICONS: Record<string, IconName> = {
  overview: 'compass',
  architecture: 'workflow',
  embedding: 'database',
  design: 'layers',
};

const iconOf = (tags: string[]): IconName => tags.map((tag) => ICONS[tag]).find(Boolean) ?? 'file-text';

const [projects, projectChats, chats, profile] = await Promise.all([
  getProjects(),
  getProjectChats(),
  getChats(),
  getProfile(),
]);
const projectTitles = new Map(projects.map((project) => [project.id, project.data.title]));
const projectOrder = new Map(projects.map((project, index) => [project.id, index]));

// 프로젝트 대화를 먼저(프로젝트 순서 → 대화 순서), 그다음 추천한 단독 글을 놓습니다.
const ordered = [
  ...projectChats.sort(
    (a, b) => (projectOrder.get(projectOf(a.id)) ?? 99) - (projectOrder.get(projectOf(b.id)) ?? 99),
  ),
  ...chats.filter((chat) => chat.data.suggested),
];

const cards = ordered.slice(0, CARD_LIMIT).map((chat) => ({
  // `#m-1` 로 들어가면 첫 질문부터 답변이 스트리밍됩니다.
  href: `${chatHref(chat)}#m-1`,
  question: firstQuestion(chat.body) || chat.data.title,
  source: chat.collection === 'projectChats' ? (projectTitles.get(projectOf(chat.id)) ?? '프로젝트') : '기술 글',
  icon: iconOf(chat.data.tags),
}));
// 랜딩 키워드 구름: 기술 스택 + 콘텐츠 태그 중 기술명(대문자로 시작) + 보충 목록. 대소문자 무시하고 중복 제거합니다.
const keywords = [
  ...(profile?.data.stack ?? []),
  ...[...projects, ...projectChats, ...chats].flatMap((entry) => entry.data.tags).filter((tag) => /^[A-Z]/.test(tag)),
  ...site.landing.keywords,
].filter((word, i, all) => all.findIndex((other) => other.toLowerCase() === word.toLowerCase()) === i);

const landingStats = [
  { label: '프로젝트', value: projects.length },
  { label: '대화', value: projectChats.length + chats.length },
  { label: '질문', value: [...projectChats, ...chats].reduce((sum, chat) => sum + (chat.body?.match(/^:::user/gm)?.length ?? 0), 0) },
];
---

<AppLayout>
  <HeroIntro text={site.hero.text} landing={site.landing} keywords={keywords.slice(0, 22)} stats={landingStats} />

  <main class="flex flex-1 flex-col items-center justify-center px-4 pb-[14vh]">
    <div class="w-full max-w-3xl">
      <h1 class="text-center text-[1.75rem] font-medium tracking-tight">{site.greeting}</h1>
      <p class="mt-2 text-center text-fg-muted">{site.hero.title}</p>

      <div class="mt-8">
        <ChatInput placeholder={site.inputPlaceholder} />
      </div>

      {cards.length > 0 && (
        <section class="mt-8">
          <h2 class="px-1 text-xs font-medium text-fg-subtle">질문으로 바로 시작하기</h2>
          <ul class="card-rail mt-3">
            {cards.map((card) => (
              <li>
                <a
                  href={card.href}
                  class="flex h-full flex-col rounded-2xl border border-border bg-elevated p-4 transition-[translate,box-shadow] duration-200 ease-easing hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgb(0_0_0_/_0.06)]"
                  data-pressable
                >
                  <span class="grid size-9 place-items-center rounded-xl border border-border text-fg-muted">
                    <Icon name={card.icon} size={18} />
                  </span>
                  <span class="mt-4 block truncate text-xs text-fg-subtle">{card.source}</span>
                  <span class="mt-1 line-clamp-3 block text-sm leading-snug">{card.question}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </main>
</AppLayout>
