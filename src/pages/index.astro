---
import AppLayout from '../layouts/AppLayout.astro';
import ChatInput from '../components/ChatInput.astro';
import site from '../content/site.json';
import { chatHref, firstQuestion, getProjects, getSuggestedChats, projectOf } from '../lib/content';

const [suggestions, projects] = await Promise.all([getSuggestedChats(), getProjects()]);
const projectTitles = new Map(projects.map((project) => [project.id, project.data.title]));

const cards = suggestions.slice(0, 4).map((chat) => ({
  href: `${chatHref(chat)}#m-1`,
  question: firstQuestion(chat.body) || chat.data.title,
  source: chat.collection === 'projectChats' ? projectTitles.get(projectOf(chat.id)) : '채팅',
}));
---

<AppLayout>
  <main class="flex flex-1 flex-col items-center justify-center px-4 pb-[14vh]">
    <div class="w-full max-w-3xl">
      <h1 class="text-center text-[1.75rem] font-medium tracking-tight">{site.greeting}</h1>
      <p class="mt-2 text-center text-fg-muted">{site.hero.title}</p>

      <div class="mt-8">
        <ChatInput placeholder={site.inputPlaceholder} />
      </div>

      {cards.length > 0 && (
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {cards.map((card) => (
            <li>
              <a href={card.href} class="block h-full rounded-2xl border border-border px-4 py-3 hover:bg-hover" data-pressable>
                <span class="line-clamp-2 block text-sm">{card.question}</span>
                {card.source && <span class="mt-1 block truncate text-xs text-fg-subtle">{card.source}</span>}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>
</AppLayout>
