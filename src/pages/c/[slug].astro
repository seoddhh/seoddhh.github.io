---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import AppLayout from '../../layouts/AppLayout.astro';
import ChatComposer from '../../components/ChatComposer.astro';
import ChatStream from '../../components/ChatStream.astro';
import { getChats } from '../../lib/content';

export const getStaticPaths = (async () => {
  const chats = await getChats();
  return chats.map((chat) => ({ params: { slug: chat.id }, props: { chat } }));
}) satisfies GetStaticPaths;

const { chat } = Astro.props;
const { Content } = await render(chat);
---

<AppLayout title={chat.data.title}>
  <p slot="header" class="truncate text-sm">{chat.data.title}</p>

  <main class="mx-auto w-full max-w-3xl flex-1 px-4 pt-2 pb-8">
    <ChatStream id={chat.id}>
      <Content />
    </ChatStream>
  </main>

  <ChatComposer />
</AppLayout>
