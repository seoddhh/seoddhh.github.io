---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import AppLayout from '../../../layouts/AppLayout.astro';
import ChatComposer from '../../../components/ChatComposer.astro';
import ChatStream from '../../../components/ChatStream.astro';
import EdgeFlash from '../../../components/EdgeFlash.astro';
import { chatSlugOf, getProjectChats, getProjects, projectOf } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const [projects, chats] = await Promise.all([getProjects(), getProjectChats()]);
  const projectById = new Map(projects.map((project) => [project.id, project]));

  return chats.flatMap((chat) => {
    const project = projectById.get(projectOf(chat.id));
    if (!project) return [];
    return [{ params: { project: project.id, chat: chatSlugOf(chat.id) }, props: { chat, project } }];
  });
}) satisfies GetStaticPaths;

const { chat, project } = Astro.props;
const { Content } = await render(chat);
---

<AppLayout title={`${chat.data.title} · ${project.data.title}`} description={project.data.summary}>
  <EdgeFlash />
  <nav slot="header" class="flex min-w-0 items-center gap-1.5 text-sm" aria-label="경로">
    <a href={`/p/${project.id}`} class="truncate text-fg-muted transition-colors duration-150 ease-easing hover:text-fg">
      {project.data.title}
    </a>
    <span class="text-fg-subtle" aria-hidden="true">/</span>
    <span class="truncate">{chat.data.title}</span>
  </nav>

  <main class="mx-auto w-full max-w-3xl flex-1 px-4 pt-2 pb-8">
    <ChatStream id={chat.id}>
      <Content />
    </ChatStream>
  </main>

  <ChatComposer placeholder={`${project.data.title}에 대해 물어보세요`} />
</AppLayout>
