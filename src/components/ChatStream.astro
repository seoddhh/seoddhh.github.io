---
// 대화를 질문 단위로 나눠, 방문자가 보낸 질문만 답변을 스트리밍합니다 (SPEC 3.6).
// 다음 질문은 입력창에 타이핑되듯 채워지고, Enter를 누르면 답변이 열립니다.
// HTML은 빌드 시 전부 생성되므로 JS가 없으면 전문이 그대로 보입니다.
interface Props {
  id: string;
}

const { id } = Astro.props;
---

{/* 감추기는 본문 파싱 전에 동기로 결정해야 깜빡임이 없습니다. */}
<script is:inline>
  document.documentElement.dataset.chatStream = 'armed';
</script>

<article class="prose prose-chat max-w-none" data-chat={id}>
  <slot />
</article>

<div class="mt-6 flex justify-center">
  <button type="button" class="chat-skip" data-chat-skip hidden data-pressable>건너뛰기</button>
</div>

<script>
  const root = document.documentElement;
  const article = document.querySelector<HTMLElement>('[data-chat]');
  const form = document.querySelector<HTMLFormElement>('[data-chat-input]');
  const field = form?.querySelector('textarea');
  const skipButton = document.querySelector<HTMLButtonElement>('[data-chat-skip]');

  if (article && form && field && root.dataset.chatStream === 'armed') {
    // 통째로 페이드인하는 블록. 마크업이 깨져 보이지 않도록 타이핑하지 않습니다.
    const FADE = new Set(['PRE', 'TABLE', 'FIGURE', 'IMG', 'HR']);
    // 항목 단위로 나눠 드러낼 컨테이너
    const SPLIT = new Set(['UL', 'OL']);
    const CHARS_PER_SECOND = 260;
    // 입력창에 질문을 채우는 속도. 사람이 치는 것처럼 답변보다 느리게 둡니다.
    const QUESTION_CHAR_MS = 45;

    type Item = { el: HTMLElement; typed: boolean; nodes: Text[]; texts: string[] };
    type Answer = { turn: HTMLElement; items: Item[] };
    type Pair = { user: HTMLElement; answers: Answer[]; text: string; opened: boolean };

    const instant = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // 터치 기기에서 포커스를 주면 가상 키보드가 올라오므로 마우스 환경에서만 포커스합니다.
    const canFocus = matchMedia('(pointer: fine)').matches;
    const placeholder = field.placeholder;
    let cancel: (() => void) | null = null;
    let skipping = false;
    let follow = true;
    let lastY = window.scrollY;

    const bottom = () => {
      if (follow) window.scrollTo({ top: document.body.scrollHeight });
    };

    // 사용자가 위로 스크롤하면 자동 스크롤을 멈추고, 다시 바닥에 닿으면 재개합니다.
    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        if (y + window.innerHeight >= document.body.scrollHeight - 80) follow = true;
        else if (y < lastY - 2) follow = false;
        lastY = y;
      },
      { passive: true },
    );

    const wait = (ms: number) =>
      new Promise<void>((resolve) => {
        if (skipping) return resolve();
        const timer = window.setTimeout(() => {
          cancel = null;
          resolve();
        }, ms);
        cancel = () => {
          window.clearTimeout(timer);
          resolve();
        };
      });

    const textNodesOf = (el: HTMLElement) => {
      const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      const nodes: Text[] = [];
      for (let node = walker.nextNode(); node; node = walker.nextNode()) nodes.push(node as Text);
      return nodes;
    };

    // 턴의 직계 자식을 드러낼 단위로 나눕니다. 목록은 항목(li) 단위까지 내려갑니다.
    const collect = (parent: Element, out: Item[] = []) => {
      for (const child of Array.from(parent.children) as HTMLElement[]) {
        child.dataset.blockPending = '';
        if (SPLIT.has(child.tagName)) {
          collect(child, out);
          continue;
        }
        if (FADE.has(child.tagName)) {
          out.push({ el: child, typed: false, nodes: [], texts: [] });
          continue;
        }
        const nodes = textNodesOf(child);
        const texts = nodes.map((node) => node.data);
        nodes.forEach((node) => (node.data = ''));
        out.push({ el: child, typed: true, nodes, texts });
      }
      return out;
    };

    const restore = (item: Item) => item.nodes.forEach((node, i) => (node.data = item.texts[i]));

    // 자기 자신과, 아직 감춰져 있는 조상(목록 래퍼)까지 함께 드러냅니다.
    const show = (el: HTMLElement, animate = true) => {
      for (let node: HTMLElement | null = el; node?.dataset.blockPending !== undefined; node = node.parentElement) {
        delete node.dataset.blockPending;
        if (animate) node.dataset.enter = '';
      }
    };

    const type = (item: Item) =>
      new Promise<void>((resolve) => {
        item.el.dataset.typing = '';
        let index = 0;
        let offset = 0;
        let budget = 0;
        let last = performance.now();
        let frame = 0;

        const tick = (now: number) => {
          budget += ((now - last) / 1000) * CHARS_PER_SECOND;
          last = now;
          let take = Math.floor(budget);
          budget -= take;

          while (take > 0 && index < item.nodes.length) {
            const full = item.texts[index];
            const step = Math.min(take, full.length - offset);
            offset += step;
            take -= step;
            item.nodes[index].data = full.slice(0, offset);
            if (offset < full.length) break;
            index += 1;
            offset = 0;
          }

          bottom();
          if (index >= item.nodes.length) {
            delete item.el.dataset.typing;
            cancel = null;
            resolve();
            return;
          }
          frame = requestAnimationFrame(tick);
        };

        cancel = () => {
          cancelAnimationFrame(frame);
          resolve();
        };
        frame = requestAnimationFrame(tick);
      });

    const think = async (turn: HTMLElement) => {
      const dots = document.createElement('div');
      dots.className = 'chat-thinking';
      dots.setAttribute('aria-hidden', 'true');
      dots.append(document.createElement('span'), document.createElement('span'), document.createElement('span'));
      turn.prepend(dots);
      bottom();
      await wait(500);
      dots.remove();
    };

    // 질문 턴 하나 + 뒤따르는 답변 턴들을 한 쌍으로 묶습니다.
    const pairs: Pair[] = [];
    for (const turn of Array.from(article.querySelectorAll<HTMLElement>('.chat-turn'))) {
      turn.dataset.pending = '';
      if (turn.dataset.role === 'user') {
        pairs.push({ user: turn, answers: [], text: turn.textContent?.trim() ?? '', opened: false });
        continue;
      }
      pairs.at(-1)?.answers.push({ turn, items: collect(turn) });
    }

    // 여기부터는 턴마다 붙은 data-pending 이 표시를 결정합니다.
    root.dataset.chatStream = 'ready';

    const openAll = (pair: Pair) => {
      delete pair.user.dataset.pending;
      for (const answer of pair.answers) {
        delete answer.turn.dataset.pending;
        answer.turn.querySelector('.chat-thinking')?.remove();
        for (const item of answer.items) {
          restore(item);
          delete item.el.dataset.typing;
          show(item.el, false);
        }
      }
    };

    // ChatInput이 input 이벤트로 높이와 보내기 버튼 상태를 맞춥니다.
    const setField = (value: string) => {
      field.value = value;
      field.dispatchEvent(new Event('input'));
    };

    let stopSuggest: (() => void) | null = null;
    let finishSuggest: (() => void) | null = null;

    // 다음 질문을 입력창에 한 글자씩 채웁니다. 전송은 방문자가 Enter로 합니다.
    const suggest = (pair: Pair) => {
      field.disabled = false;
      field.placeholder = placeholder;
      if (canFocus) field.focus({ preventScroll: true });

      let index = instant ? pair.text.length : 0;
      setField(pair.text.slice(0, index));
      if (index >= pair.text.length) return;

      const timer = window.setInterval(() => {
        index += 1;
        setField(pair.text.slice(0, index));
        if (index >= pair.text.length) finishSuggest?.();
      }, QUESTION_CHAR_MS);

      stopSuggest = () => {
        window.clearInterval(timer);
        stopSuggest = finishSuggest = null;
      };
      finishSuggest = () => {
        stopSuggest?.();
        setField(pair.text);
      };
    };

    // 대화 흐름이 끊기지 않도록 다음 차례 질문 하나만 제시합니다.
    const render = () => {
      const next = pairs.find((pair) => !pair.opened);
      if (next) return suggest(next);
      field.disabled = false;
      field.placeholder = placeholder;
      setField('');
    };

    const open = async (pair: Pair) => {
      if (pair.opened) return;
      // 중간 질문으로 바로 들어와도 앞 대화는 순서대로 남아 있어야 합니다.
      for (const earlier of pairs.slice(0, pairs.indexOf(pair))) {
        if (earlier.opened) continue;
        earlier.opened = true;
        openAll(earlier);
      }
      pair.opened = true;
      follow = true;

      // 답변이 끝날 때까지 입력창을 잠급니다.
      stopSuggest?.();
      setField('');
      field.disabled = true;
      field.placeholder = '답변하는 중…';

      if (instant) {
        openAll(pair);
        render();
        pair.user.scrollIntoView({ block: 'start' });
        return;
      }

      if (skipButton) skipButton.hidden = false;
      article.setAttribute('aria-busy', 'true');
      document.dispatchEvent(new CustomEvent('edge-flash'));

      delete pair.user.dataset.pending;
      pair.user.dataset.enter = '';
      bottom();
      await wait(450);

      for (const answer of pair.answers) {
        delete answer.turn.dataset.pending;
        if (skipping) break;
        await think(answer.turn);
        for (const item of answer.items) {
          if (skipping) break;
          show(item.el);
          if (item.typed) await type(item);
          else {
            bottom();
            await wait(260);
          }
        }
      }

      openAll(pair);
      skipping = false;
      cancel = null;
      article.setAttribute('aria-busy', 'false');
      if (skipButton) skipButton.hidden = true;
      render();
    };

    const skip = () => {
      if (article.getAttribute('aria-busy') !== 'true') return;
      skipping = true;
      cancel?.();
    };

    // 입력창에서 보낸 질문이 다음 차례 질문과 같으면 답변을 엽니다.
    form.addEventListener('chat:ask', (event) => {
      const question = (event as CustomEvent<string>).detail;
      const pair = pairs.find((candidate) => !candidate.opened && candidate.text === question);
      if (pair) open(pair);
    });
    // 채우는 도중 키를 누르거나 입력창을 누르면 질문을 끝까지 채웁니다.
    // capture 단계라 ChatInput의 Enter 전송보다 먼저 실행됩니다.
    form.addEventListener('keydown', () => finishSuggest?.(), { capture: true });
    field.addEventListener('pointerdown', () => finishSuggest?.());

    skipButton?.addEventListener('click', skip);
    article.addEventListener('click', (event) => {
      // 링크·코드 복사 같은 상호작용은 건드리지 않습니다.
      if (!(event.target as Element).closest('a, button, pre')) skip();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') skip();
    });

    render();

    // `#m-3` 으로 들어오면 그 질문은 바로 펼칩니다. (홈 카드가 이 형태로 링크합니다)
    const anchor = document.getElementById(location.hash.slice(1));
    const chosen = pairs.find((pair) => pair.user === anchor);
    if (chosen) open(chosen);
  }
</script>
